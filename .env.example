# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/insightdesk

# Redis Cache & Celery Broker
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Set to 'mock' for free local evaluation without API keys)
LLM_PROVIDER=mock
OPENAI_API_KEY=

# Security
JWT_SECRET=super-secret-jwt-key-for-development-change-in-production
